# ------------------------------------------------------------------
# PayOnPass — environment configuration (copy to .env and fill in)
# ------------------------------------------------------------------

# PayPal Sandbox Credentials (never use live credentials here)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id_here
# A real sandbox worker email is required for live payouts (Step 0 hard gate)
PAYPAL_WORKER_EMAIL=sandbox-worker@example.com

# MongoDB (URI must be URL-escaped if the password contains special chars)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=payonpass

# LLM Configuration (Supported: gemini, openai, anthropic).
# Leave LLM_API_KEY empty to run the honest offline demo-matrix fallback.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Funding model: "live" (PayPal approval + real capture) or "prefunded" (mock,
# used for unattended automated demos).
FUNDING_MODE=live

# Settle model: "paypal" (real payouts/refunds) or "mock" (simulated money loop
# for demos/CI where the merchant country blocks payouts; ledger stays truthful
# with mode="prefunded").
SETTLE_MODE=paypal

# Platform Economics & Thresholds (in Basis Points: 10000 = 100%)
FEE_RATE_BP=1000            # or PLATFORM_FEE_BP (alias)
PASS_BP=8500
FAIL_BP=5000
REVIEW_MARGIN_BP=500

# Spending Guardrails (in Integer Cents)
MAX_JOB_CENTS=50000
DAILY_CAP_CENTS=200000

# Agent API key (worker agents). Empty = agent endpoints unauthenticated.
AGENT_API_KEYS=

# Demo affordances (/demo/*): tamper test + one-click scenario runner. Opt-in;
# leave false in anything that isn't a sandbox demo.
ENABLE_DEV_TOOLS=false

# Server & Routing
PUBLIC_BASE_URL=http://localhost:8000
PORT=8000